[Unit]
Description=Fire motors at specified time, see below

[Timer]
#Test schedule, occurs every minute
# Comment out with a # to get rid of test schedule
#OnCalendar=*-*-* *:*:00

#Regular Schedule, get rid of # on each line to activate schedule
OnCalendar=*-*-* 00:24:00
OnCalendar=*-*-* 05:12:00
OnCalendar=*-*-* 10:00:00
OnCalendar=*-*-* 14:48:00
OnCalendar=*-*-* 19:36:00
Persistent=true

[Install]
WantedBy=timers.target
